# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=myapp
DB_SSL=false

# Application
APP_PORT=3001
NODE_ENV=development

# Secrets: required, at least 32 characters. The app refuses to start otherwise.
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

# Session
SESSION_SECRET=

# JWT
JWT_SECRET=
JWT_EXPIRATION=24h
